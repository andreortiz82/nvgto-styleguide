---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { SerpPageDemo } from "../../../components/demos/v2/PageDemos";

const base = import.meta.env.BASE_URL;
---

<DocsLayout title="SERP">
  <Breadcrumb base={base} tier="Pages" tierHref="/components/pages/" />
  <h1>SERP — Search results</h1>
  <p>Search, price range, min rating, and sort change which fixture stays show (sold-out stays remain when they match). Skeleton and empty states stay. Map markers stay decorative.</p>
  <SerpPageDemo client:load />
</DocsLayout>
