---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { PdpPageDemo } from "../../../components/demos/v2/PageDemos";
import { PhotoCredits } from "../../../components/PhotoCredits";

const base = import.meta.env.BASE_URL;
---

<DocsLayout title="PDP">
  <Breadcrumb base={base} tier="Pages" tierHref="/components/pages/" />
  <h1>PDP — Property detail</h1>
  <p>One stay: gallery, location, amenities, reviews, and a sticky booking widget. Toggle empty dates, a real range, and sold-out — Reserve never invents nights.</p>
  <PdpPageDemo client:load />
  <PhotoCredits
    files={[
      "hotel-pool.jpg",
      "hotel-suite.jpg",
      "hotel-bedroom.jpg",
      "resort-terrace.jpg",
      "hotel-bed-linen.jpg",
      "hotel-bathroom.jpg",
      "beach.jpg",
      "spa-amenity.jpg",
    ]}
  />
</DocsLayout>
